<settings>
  <file_management>
    <relative_file_path_structure>{date{yyyy}}/{date{MMM}}/{date{dd}}/{{guid}}/{file{name}}</relative_file_path_structure>
    <!--
      The variables you can use in the relative file path structure are:
        {date{yyyy}} - year in 4 digits
        {date{MMM}} - month in 3 letters
        {date{dd}} - day in 2 digits
        Note: you can change the date formats as you want by using standard .NET date format patterns
        {{guid}} - the file's id: a new GUID, or the caller's own id when accept_caller_defined_file_ids is true
                   and the entry's id is a valid GUID
        {file{name}} - the file name from the upload entry, after the engine's checks
        Keep the whole value on one line: whitespace inside the element becomes part of every path.

        The file structure above to be appended to the local path defined in each local file store node below
        or the remote path defined in each sftp file store node below
    -->

    <permitted_file_extensions>.txt,.pdf,.docx,.xlsx,.png,.jpg,.jpeg</permitted_file_extensions>
    <!-- this is the default permitted file extensions, and can be overriden 
          per API node in sql.xml
          if not defined, all file extensions will be permitted
          override precedence is: API node > global setting here
          NOTE: permittedFileExtensions should contain extensions WITH the dot (e.g., .txt, .pdf")

          -->

    <max_number_of_files>5</max_number_of_files>
    <!-- max_number_of_files is optional; if not defined anywhere, there is no limit.
    It counts every entry in the request, including existing files kept in an update.
    Can be overridden per API node in sql.xml
    override precedence is: API node > global setting here
      -->

    <max_file_size_in_bytes>314572800</max_file_size_in_bytes>
    <!-- 300 MB -->
    <!-- this is the default max file size in bytes, and can be overriden
          per API node in sql.xml
          if not defined anywhere, there is no per-file limit; only max_payload_size_in_bytes
          in settings.xml caps the whole request
          override precedence is: API node > global setting here
          max_payload_size_in_bytes applies only when the engine runs on Kestrel. Under IIS's
          default in-process hosting, IIS's maxAllowedContentLength (web.config) and
          ASP.NET Core's IISServerOptions.MaxRequestBodySize (both about 30 MB) apply instead,
          and the engine cannot raise the second. For larger uploads behind IIS, host
          out-of-process (hostingModel="outofprocess" in web.config) and raise
          maxAllowedContentLength.
          -->


    <!-- 
        the below two field can be overriden by the individual query in `queries` settings
        and if not defined there, these global settings will be used here.
        And if not defined here, the default values in code will be used: 
        `name` for filename field and `base64_content` for base64 content field.
        
        precedence order is: API node in sql.xml > global setting here > default in code.
        Upload entries must use these exact names (here: `name` and `content_base64`). An entry whose
        content field has another name is treated as an existing file and nothing is stored.
    -->
    <filename_field_in_payload>name</filename_field_in_payload>
    <base64_content_field_in_payload>content_base64</base64_content_field_in_payload>

    <!-- 
      if set to `true`, the system accepts API caller's Guid if sent alongside files.
      otherwise system generates its own Guid for each file.
      Recommendation is to keep it `false` unless you have a specific reason to set it to `true`
      (e.g., B2B system where the caller wants to define its own file IDs for tracking purposes)
    -->
    <accept_caller_defined_file_ids>false</accept_caller_defined_file_ids>


    <!-- you can define as many local file stores or sftp stores as you want, and reference their names
      in your API node in sql.xml:
        uploads:   <file_management><stores>location1,myfiles,site4</stores></file_management>
        downloads: <file_management><store>location1</store></file_management>  (one store)
      You can give these locations any names you want (e.g., location1, siteA, myFiles, etc..)
      A <stores> element directly under <file_management> in this file is the default for upload
      routes that set none. A route that sets its own <stores> never falls back to it.
      An upload route that gets no store from either place, or only unknown ones, stores nothing yet still succeeds.
      Its query still receives each new file entry with is_new_upload set to true and a relative_path,
      so a query that saves those paths records files that do not exist.
    -->
    <local_file_store>
      <site1>
        <base_path><![CDATA[c:\myfiles\]]></base_path>
      </site1>
      <site2>
        <base_path><![CDATA[g:\site2\]]></base_path>
        <!-- if optional is set to `true`, it means if the file failed to be copied to this location (for any reason), 
        it will be ignored and the process will continue without failing the entire request.
        default is `false` if tag is not present
        -->
        <optional>true</optional>

      </site2>
      <!-- A Windows file share works as a base path too. Write it as a UNC path, either
        \\fileserver\share\uploads\ or //fileserver/share/uploads/.
        The account the app runs as needs Modify on the share folder: write for uploads, delete to
        roll back a failed upload, read for downloads. Under IIS's default app pool identity, or a
        service running as a built-in account, the app reaches the share as the server's computer
        account (DOMAIN\SERVER$), so grant that account, or run the pool or service as a domain
        account and grant that one instead.
        On Linux or in a container, mount the share first and point base_path at the mount.
      <site5>
        <base_path><![CDATA[\\fileserver\share\uploads\]]></base_path>
      </site5>
      -->
    </local_file_store>

    <sftp_file_store>
      <site3>
        <host><![CDATA[test_sftp]]></host>
        <port>3333</port>
        <username><![CDATA[t]]></username>
        <password><![CDATA[123]]></password>
        <base_path><![CDATA[/site3/]]></base_path>
        <!-- if optional is set to `true`, it means if the file failed to be copied to this location (for any reason), 
        it will be ignored and the process will continue without failing the entire request
        default is `false` if tag is not present
        -->
        <optional>true</optional>
      </site3>
      <site4>
        <host><![CDATA[test_sftp]]></host>
        <port>3333</port>
        <username><![CDATA[t]]></username>
        <password><![CDATA[123]]></password>
        <base_path><![CDATA[/site4/]]></base_path>
      </site4>



    </sftp_file_store>

  </file_management>

</settings>