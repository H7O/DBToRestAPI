<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <Version>1.4.0</Version>
  <AssemblyVersion>1.4.0.0</AssemblyVersion>
  <FileVersion>1.4.0.0</FileVersion>
  <InformationalVersion>1.4.0</InformationalVersion>
</PropertyGroup>

<!--
  Database provider set. Default 'full' includes every supported provider.
  Build a smaller engine (Microsoft SQL Server + SQLite only) with:
      dotnet publish -p:DbProviders=lite
  The lite flavor drops the heavy provider packages (Npgsql, MySQL, Oracle, DB2, ODBC, OleDb) and
  switches to Workstation GC, which is friendlier on small / low-RAM hosts. Provider assemblies are
  loaded lazily either way (see DbConnectionFactory), so unused providers never load into memory.
-->
<PropertyGroup>
  <DbProviders Condition="'$(DbProviders)' == ''">full</DbProviders>
</PropertyGroup>

<PropertyGroup Condition="'$(DbProviders)' == 'lite'">
  <ServerGarbageCollection>false</ServerGarbageCollection>
</PropertyGroup>

<!-- Allow test project to access internal types -->
<ItemGroup>
  <InternalsVisibleTo Include="DBToRestAPI.Tests" />
</ItemGroup>

<ItemGroup>
  <Compile Remove="Services\RoutingGateway.cs" />
</ItemGroup>


  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Com.H" Version="10.1.0" />
    <PackageReference Include="Com.H.Data.Common" Version="10.1.0.7" />
    <PackageReference Include="Com.H.Net.Ssh" Version="10.0.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />

    <!-- Heavy/optional database providers — excluded from the 'lite' build (-p:DbProviders=lite) -->
    <PackageReference Include="MySqlConnector" Version="2.5.0" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="Npgsql" Version="10.0.3" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.8" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.8" Condition="'$(DbProviders)' != 'lite'" />

    <!-- DB2 - Platform-specific (only the matching package is included in build output) -->
    <!-- ExcludeAssets prevents the package's .targets from adding TestConn files to the project -->
    <PackageReference Include="Net.IBM.Data.Db2" Version="*" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DbProviders)' != 'lite'" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="*" Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(DbProviders)' != 'lite'" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Net.IBM.Data.Db2-osx" Version="*" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(DbProviders)' != 'lite'" ExcludeAssets="build;buildTransitive" />


  </ItemGroup>

  <!--
    DB2's native CLI driver (clidriver) is ~80 MB and is x64/OS-specific, so it is bundled only when it is
    actually usable — otherwise every full release would carry 80 MB of (often foreign-platform) native
    libraries for a niche provider.

    Default: included for local (RID-less) `dotnet build`/`run` so DB2 works in development, but NOT for
    self-contained release builds. To produce a ready-to-run DB2 release build, opt in on the matching
    x64 platform:  dotnet publish -r linux-x64 -p:IncludeDb2Native=true
    Without the native driver the managed DB2 provider is still present, but a DB2 connection fails until
    the IBM Data Server Driver is available on the host. DB2 is excluded from lite builds entirely.
  -->
  <PropertyGroup>
    <IncludeDb2Native Condition="'$(IncludeDb2Native)' == '' and '$(RuntimeIdentifier)' == ''">true</IncludeDb2Native>
    <IncludeDb2Native Condition="'$(IncludeDb2Native)' == ''">false</IncludeDb2Native>
  </PropertyGroup>

  <!-- Bundle the clidriver only when opted in, not lite, and the target is the matching build-host x64
       platform (a RID-less local build always targets the host). This prevents shipping, e.g., Linux
       .so files inside a Windows build, or x64 libraries inside an arm64 build. IBM ships the DB2 client
       driver for Windows and Linux x64; macOS / arm64 DB2 are not supported, so they are not matched. -->
  <PropertyGroup Condition="'$(DbProviders)' != 'lite' and '$(IncludeDb2Native)' == 'true'">
    <_Db2NativeOsMatch>false</_Db2NativeOsMatch>
    <_Db2NativeOsMatch Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64')">true</_Db2NativeOsMatch>
    <_Db2NativeOsMatch Condition="$([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'linux-x64')">true</_Db2NativeOsMatch>
  </PropertyGroup>

  <!--
    DB2 CLI driver post-build copy:
    The NuGet package places clidriver files in a versioned subfolder, but the runtime expects them
    in the root 'clidriver' folder. This target copies files from the highest version and cleans up.
  -->
  <Target Name="CopyDb2CliDriver" AfterTargets="Build" Condition="'$(_Db2NativeOsMatch)' == 'true'">
    <!-- Windows -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Db2PackagePath>$(NuGetPackageRoot)net.ibm.data.db2</Db2PackagePath>
    </PropertyGroup>
    <!-- Linux -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <Db2PackagePath>$(NuGetPackageRoot)net.ibm.data.db2-lnx</Db2PackagePath>
    </PropertyGroup>
    <!-- macOS -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <Db2PackagePath>$(NuGetPackageRoot)net.ibm.data.db2-osx</Db2PackagePath>
    </PropertyGroup>

    <!-- Find all version folders and pick the highest one (sorted descending, first item) -->
    <ItemGroup>
      <Db2VersionFolders Include="$([System.IO.Directory]::GetDirectories('$(Db2PackagePath)'))" />
    </ItemGroup>
    <PropertyGroup>
      <Db2LatestVersion>@(Db2VersionFolders-&gt;Reverse()-&gt;DirectoryName())</Db2LatestVersion>
    </PropertyGroup>

    <!-- Get the highest version folder path -->
    <ItemGroup>
      <Db2SortedVersions Include="@(Db2VersionFolders)" />
    </ItemGroup>

    <!-- Copy clidriver contents from the NuGet package to output -->
    <ItemGroup>
      <Db2CliDriverFiles Include="$(Db2PackagePath)\**\buildTransitive\clidriver\**\*.*" />
    </ItemGroup>

    <Message Importance="high" Text="Copying DB2 CLI driver files to $(OutputPath)clidriver\" />

    <!-- Use Robocopy on Windows for reliable folder copy -->
    <Exec Command="robocopy &quot;$(Db2PackagePath)&quot; &quot;$(OutputPath)clidriver&quot; /S /NFL /NDL /NJH /NJS /NC /NS /NP /XD &quot;$(Db2PackagePath)&quot;" Condition="$([MSBuild]::IsOSPlatform('Windows'))" IgnoreExitCode="true" ContinueOnError="true" />

    <!-- PowerShell approach: Find highest version, copy clidriver contents, remove versioned folders -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$versions = Get-ChildItem -Path '$(Db2PackagePath)' -Directory | Sort-Object { [Version]$_.Name } -Descending; if ($versions) { $latest = $versions[0].FullName; $src = Join-Path $latest 'buildTransitive\clidriver'; if (Test-Path $src) { Copy-Item -Path (Join-Path $src '*') -Destination '$(OutputPath)clidriver' -Recurse -Force } }&quot;" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    
    <Exec Command="bash -c &quot;latest=\$(ls -v '$(Db2PackagePath)' | tail -1); src='$(Db2PackagePath)'/\$latest/buildTransitive/clidriver; if [ -d \&quot;\$src\&quot; ]; then mkdir -p '$(OutputPath)clidriver' &amp;&amp; cp -r \$src/* '$(OutputPath)clidriver/'; fi&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" ContinueOnError="true" />

    <!-- Clean up versioned folders from output (remove folders that look like version numbers) -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -Path '$(OutputPath)clidriver' -Directory | Where-Object { $_.Name -match '^\d+\.\d+\.\d+' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue&quot;" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    
    <Exec Command="bash -c &quot;find '$(OutputPath)clidriver' -maxdepth 1 -type d -regex '.*/[0-9]+\.[0-9]+\.[0-9]+.*' -exec rm -rf {} + 2&gt;/dev/null || true&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <!--
    Mirror the DB2 clidriver into the PUBLISH output. CopyDb2CliDriver (above) only populates the build
    output ($(OutputPath)); `dotnet publish` writes a separate folder, so without this the native driver
    is missing from published / released builds and DB2 connections fail at runtime. This reuses the files
    the build target already staged, under the same host-OS gate (so cross-published artifacts never get
    foreign-OS native libraries).
  -->
  <Target Name="CopyDb2CliDriverToPublish" AfterTargets="Publish" Condition="'$(_Db2NativeOsMatch)' == 'true'">
    <ItemGroup>
      <_Db2PublishCliDriver Include="$(OutputPath)clidriver\**\*" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_Db2PublishCliDriver)' != ''" Text="Copying DB2 CLI driver into publish output: $(PublishDir)clidriver\" />
    <Copy Condition="'@(_Db2PublishCliDriver)' != ''"
          SourceFiles="@(_Db2PublishCliDriver)"
          DestinationFiles="@(_Db2PublishCliDriver->'$(PublishDir)clidriver\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Update="config\api_keys.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\auth_providers.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\encryption_test.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\file_management.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\api_gateway.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\regex.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\settings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\sql.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\test_auth_provider.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="demo.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runme.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runme.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
