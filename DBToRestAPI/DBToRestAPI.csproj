<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
  <TargetFramework>net11.0</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <Version>1.8.1</Version>
  <AssemblyVersion>1.8.1.0</AssemblyVersion>
  <FileVersion>1.8.1.0</FileVersion>
  <InformationalVersion>1.8.1</InformationalVersion>
</PropertyGroup>

<!--
  Database provider set. Default 'full' includes every supported provider.
  Build a smaller engine (Microsoft SQL Server + SQLite only) with:
      dotnet publish -p:DbProviders=lite
  The lite flavor drops the heavy provider packages (Npgsql, MySQL, Oracle, DB2, ODBC, OleDb) and
  switches to Workstation GC, which is friendlier on small / low-RAM hosts. Provider assemblies are
  loaded lazily either way (see DbConnectionFactory), so unused providers never load into memory.
-->
<PropertyGroup>
  <DbProviders Condition="'$(DbProviders)' == ''">full</DbProviders>
</PropertyGroup>

<PropertyGroup Condition="'$(DbProviders)' == 'lite'">
  <ServerGarbageCollection>false</ServerGarbageCollection>
</PropertyGroup>

<!-- Allow test project to access internal types -->
<ItemGroup>
  <InternalsVisibleTo Include="DBToRestAPI.Tests" />
</ItemGroup>

<ItemGroup>
  <Compile Remove="Services\RoutingGateway.cs" />
</ItemGroup>


  <ItemGroup>
    <PackageReference Include="Com.H" Version="11.0.0" />
    <PackageReference Include="Com.H.Data.Common" Version="11.0.0" />
    <PackageReference Include="Com.H.Net.Ssh" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <!-- SQL Server sign-in with Entra ID: Authentication=Active Directory Managed Identity, Service
         Principal, Workload Identity or Default in a connection string. The driver looks for this
         package by name when a connection asks for such a sign-in, and loads nothing of it otherwise.
         Keep its version equal to the driver's.
         ExcludeAssets="native" leaves out the native library of the Windows account broker that comes
         with it (36 MB for Linux x64, where nothing calls it). On Windows, only the sign-ins that go
         through that broker need it (Interactive, Integrated, Password, Device Code Flow), and the
         engine doesn't support those. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" ExcludeAssets="native" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
    <!-- JWT validation and OpenID Connect discovery, called directly by Step4JwtAuthorization -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />

    <!-- Heavy/optional database providers — excluded from the 'lite' build (-p:DbProviders=lite) -->
    <PackageReference Include="MySqlConnector" Version="3.0.0" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="Npgsql" Version="10.0.3" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.401" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="System.Data.Odbc" Version="11.0.0" Condition="'$(DbProviders)' != 'lite'" />
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" Condition="'$(DbProviders)' != 'lite'" />

    <!-- DB2 - Platform-specific (only the matching package is included in build output) -->
    <!-- ExcludeAssets prevents the package's .targets from adding TestConn files to the project -->
    <PackageReference Include="Net.IBM.Data.Db2" Version="*" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DbProviders)' != 'lite'" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="*" Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(DbProviders)' != 'lite'" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <PackageReference Include="Net.IBM.Data.Db2-osx" Version="*" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(DbProviders)' != 'lite'" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />


  </ItemGroup>

  <!--
    DB2's native CLI driver (clidriver) is ~80 MB and is x64/OS-specific, so it is bundled only when it is
    actually usable — otherwise every full release would carry 80 MB of (often foreign-platform) native
    libraries for a niche provider.

    Default: included for local (RID-less) `dotnet build`/`run` so DB2 works in development, but NOT for
    self-contained release builds. To produce a ready-to-run DB2 release build, opt in on the matching
    x64 platform:  dotnet publish -r linux-x64 -p:IncludeDb2Native=true
    Without the native driver the managed DB2 provider is still present, but a DB2 connection fails until
    the IBM Data Server Driver is available on the host. DB2 is excluded from lite builds entirely.
  -->
  <PropertyGroup>
    <IncludeDb2Native Condition="'$(IncludeDb2Native)' == '' and '$(RuntimeIdentifier)' == ''">true</IncludeDb2Native>
    <IncludeDb2Native Condition="'$(IncludeDb2Native)' == ''">false</IncludeDb2Native>
  </PropertyGroup>

  <!-- Bundle the clidriver only when opted in, not lite, and the target is the matching build-host x64
       platform (a RID-less local build always targets the host). This prevents shipping, e.g., Linux
       .so files inside a Windows build, or x64 libraries inside an arm64 build. IBM ships the DB2 client
       driver for Windows and Linux x64; macOS / arm64 DB2 are not supported, so they are not matched. -->
  <PropertyGroup Condition="'$(DbProviders)' != 'lite' and '$(IncludeDb2Native)' == 'true'">
    <_Db2NativeOsMatch>false</_Db2NativeOsMatch>
    <_Db2NativeOsMatch Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64')">true</_Db2NativeOsMatch>
    <_Db2NativeOsMatch Condition="$([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'linux-x64')">true</_Db2NativeOsMatch>
  </PropertyGroup>

  <!--
    Copy the DB2 native CLI driver (clidriver) from the NuGet package into the build output so a
    self-contained build can connect to DB2. The package folder is found from the DB2 assembly that
    the build actually resolved, and a cross-platform MSBuild <Copy> copies only the clidriver subtree.
    Gated by _Db2NativeOsMatch (win-x64 / linux-x64 only). A loud warning fires if the driver can't be
    found, so it never silently goes missing again.
  -->
  <Target Name="CopyDb2CliDriver" AfterTargets="Build" Condition="'$(_Db2NativeOsMatch)' == 'true'">
    <PropertyGroup>
      <_Db2PkgId Condition="$([MSBuild]::IsOSPlatform('Windows'))">net.ibm.data.db2</_Db2PkgId>
      <_Db2PkgId Condition="$([MSBuild]::IsOSPlatform('Linux'))">net.ibm.data.db2-lnx</_Db2PkgId>
    </PropertyGroup>
    <!-- The resolved assembly sits at <package folder>/lib/<tfm>/IBM.Data.Db2.dll, so its folder's
         grandparent is the exact package version restore picked, wherever NuGet put it. Listing the
         version folders in the NuGet cache instead picked up every cached version (the package floats
         on Version="*", so an older one stays behind after each IBM release) and broke the copy.
         Before that, a GeneratePathProperty attempt read $(PkgNet_IBM_Data_Db2_lnx), but NuGet names
         that property PkgNet_IBM_Data_Db2-lnx, so it came back empty on Linux. NuGetPackageId holds
         the OS-specific id set above and is compared case-insensitively. -->
    <ItemGroup>
      <_Db2Reference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == '$(_Db2PkgId)'" />
      <_Db2PkgDir Include="$([System.IO.Path]::GetFullPath('%(_Db2Reference.RootDir)%(_Db2Reference.Directory)../..'))" Condition="'%(_Db2Reference.Identity)' != ''" />
    </ItemGroup>
    <PropertyGroup>
      <_Db2PkgDir>@(_Db2PkgDir->Distinct())</_Db2PkgDir>
    </PropertyGroup>
    <ItemGroup>
      <_Db2ClidriverFiles Include="$(_Db2PkgDir)/buildTransitive/clidriver/**/*" Condition="'$(_Db2PkgDir)' != ''" />
    </ItemGroup>
    <Message Importance="high" Text="DB2: packageDir='$(_Db2PkgDir)' -&gt; copying clidriver to '$(OutputPath)clidriver'" />
    <Warning Condition="'@(_Db2ClidriverFiles)' == ''" Text="DB2: no clidriver files found (packageDir='$(_Db2PkgDir)', package '$(_Db2PkgId)') — the DB2 native driver will be MISSING." />
    <Copy Condition="'@(_Db2ClidriverFiles)' != ''" SourceFiles="@(_Db2ClidriverFiles)" DestinationFiles="@(_Db2ClidriverFiles->'$(OutputPath)clidriver/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Mirror the DB2 clidriver into the PUBLISH output. CopyDb2CliDriver (above) only populates the build
    output ($(OutputPath)); `dotnet publish` writes a separate folder, so without this the native driver
    is missing from published / released builds and DB2 connections fail at runtime. This reuses the files
    the build target already staged, under the same host-OS gate (so cross-published artifacts never get
    foreign-OS native libraries).
  -->
  <Target Name="CopyDb2CliDriverToPublish" AfterTargets="Publish" Condition="'$(_Db2NativeOsMatch)' == 'true'">
    <ItemGroup>
      <_Db2PublishCliDriver Include="$(OutputPath)clidriver\**\*" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_Db2PublishCliDriver)' != ''" Text="Copying DB2 CLI driver into publish output: $(PublishDir)clidriver\" />
    <Copy Condition="'@(_Db2PublishCliDriver)' != ''" SourceFiles="@(_Db2PublishCliDriver)" DestinationFiles="@(_Db2PublishCliDriver->'$(PublishDir)clidriver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Every XML file under config\, so a file added there (and named in <additional_configurations>)
         reaches the build output without an entry of its own. -->
    <None Update="config\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="demo.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runme.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runme.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The docs, next to the executable in a published build (the release archives, the Docker image),
       laid out as in the repository, so AGENTS.md, CLAUDE.md and llms.txt and their links work in a
       release folder: an agent there reads the pages without a clone. A build doesn't copy them.
       DocsExamplesTests checks that every link in these pages reaches one of these files. -->
  <ItemGroup>
    <None Include="..\AGENTS.md;..\CLAUDE.md;..\llms.txt;..\llms.md;..\README.md;..\LICENSE" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\AUTHORING.md" Link="docs\AUTHORING.md" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\reference\**\*.md" Link="docs\reference\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\topics\**\*.md" Link="docs\topics\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\tutorial\**\*.md" Link="docs\tutorial\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
